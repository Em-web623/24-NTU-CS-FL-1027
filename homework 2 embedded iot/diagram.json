{
  "version": 1,
  "author": "ESP32 PWM OLED Task",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -100, "left": 200, "attrs": { "color": "red" } },
    { "type": "wokwi-led", "id": "led2", "top": -100, "left": 270, "attrs": { "color": "blue" } },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -20,
      "left": 200,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": -20,
      "left": 270,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": 100,
      "left": 250,
      "attrs": { "i2cAddress": "0x3c" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "esp:5", "led1:A", "red", [] ],
    [ "led1:C", "r1:1", "black", [] ],
    [ "r1:2", "esp:GND.1", "black", [] ],
    [ "esp:23", "led2:A", "blue", [] ],
    [ "led2:C", "r2:1", "black", [] ],
    [ "r2:2", "esp:GND.1", "black", [] ],
    [ "esp:3V3", "oled1:VCC", "red", [] ],
    [ "esp:GND.1", "oled1:GND", "black", [] ],
    [ "esp:21", "oled1:SDA", "green", [] ],
    [ "esp:22", "oled1:SCL", "blue", [] ]
  ],
  "dependencies": {}
}